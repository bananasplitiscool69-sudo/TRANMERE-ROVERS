body {
  font-family: system-ui, sans-serif;
  background: #f4f7fb;
  color: #0b2a5b;
  margin: 0;
  padding: 0;
  text-align: center;
}

header {
  background: #0b3d91;
  color: #ffffff;
  padding: 2rem 1rem;
}

header h1 {
  margin: 0 0 0.25rem;
}

.card {
  background: #ffffff;
  border: 2px solid #0b3d91;
  border-radius: 8px;
  padding: 1.5rem;
  max-width: 500px;
  margin: 1.5rem auto;
}
